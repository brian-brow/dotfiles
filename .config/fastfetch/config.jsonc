{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch2",
    "color": {
      "1": "#d0e4ff",
      "2": "#9fcafc",
    },
    "padding": {
      "top": 1,
      "right": 1,
      "left": 1,
      "bottom": 3
    }
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": {
        "user": "#9fcafc",
        "at": "#e1e2e8",
        "host": "#9fcafc"
      },
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#9fcafc",
      "color": "cyan",
    },
    {
      "type": "host",
      "key": "🖥 ",
      "keyColor": "#9fcafc",
      "color": "cyan",
      "format": "my sick pc"
    },
    {
      "type": "shell",
      "format": "{}",
      "key": ">_",
      "keyColor": "#9fcafc",
      "color": "cyan",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#9fcafc",
      "color": "cyan",
    },
    {
      "type": "wm",
      "format": "{}",
      "key": " ",
      "keyColor": "#9fcafc",
      "color": "cyan",
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "#9fcafc",
      "color": "cyan",
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "#9fcafc",
      "color": "cyan",
    },
    {
      "type": "memory",
      "key": "🎟 ",
      "keyColor": "#9fcafc",
      "color": "cyan",
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "#9fcafc",
      "color": "cyan",
      "format": "{1} / {2} ({3})"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "range": [
          0,
          15
        ]
      },
      "brightness": true
    },
    "break",
    "break",
    "break",
    "break",
  ],
}
