{
    "label" : "lock",
    "action" : "$HOME/.config/hypr/scripts/hyprlock.sh",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "sleep",
    "action" : "systemctl suspend",
    "text" : "Sleep",
    "keybind" : "z"
}
{
    "label" : "windows",
    "action" : "sudo grub-reboot 2 && reboot",
    "text" : "Windows",
    "keybind" : "w"
}
{
    "label" : "logout",
    "action" : "echo lol",
    "text" : "Logout",
    "keybind" : "o"
}
