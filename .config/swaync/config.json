{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "control-center-width": 380,
  "control-center-height": 860,
  "control-center-margin-top": 2,
  "control-center-margin-bottom": 2,
  "control-center-margin-right": 1,
  "control-center-margin-left": 0,
  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "scripts": {
    "example-script": {
      "exec": "echo 'Do something...'",
      "urgency": "Normal"
    },
    "focus-discord": {
      "app-name": "vesktop",
      "exec": "hyprctl dispatch 'hl.dsp.focus({ window = \"class:vesktop\" })'",
      "run-on": "action"
    }
  },
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "label",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " 󰎟 "
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label": {
      "max-lines": 1,
      "text": " "
    },
    "notifications": {
      "max-height": 100,
      "max-width": 400
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "",
          "command": "amixer set Master toggle"
        },
        {
          "label": "",
          "command": "amixer set Capture toggle"
        },
        {
          "label": "",
          "command": "qs ipc call network toggle"
        },
        {
          "label": "󰂯",
          "command": "qs ipc call bluetooth toggle"
        },
        {
          "label": "󰏘",
          "command": "hyprpicker -a"
        },
        {
          "label": "󰑋",
          "type": "toggle",
          "active": false,
          "command": "~/.config/hypr/scripts/record-toggle.sh",
          "update-command": "pgrep -x wf-recorder >/dev/null && echo true || echo false"
        }
      ]
    }
  }
}
