;; Music vars
(defpoll SONG :interval "1s" "scripts/music_info --song")
(defpoll ARTIST :interval "1s" `scripts/music_info --artist`)
(defpoll COVER :interval "1s" `scripts/music_info --cover`)
(defpoll STATUS :interval "1s" `scripts/music_info --status`)

(defvar wallpaper_path "/home/brian/Wallpapers/")
(defvar music_reveal false)
(defvar stack_index 0)
(defvar current-volume 50)

(defvar eww "/usr/bin/eww -c $HOME/.config/eww")

;; music
(defwidget music [] 
		(box :class "dockbox"
			(box :orientation "h" :spacing 0 :valign "center" :halign "start" :space-evenly "false" :vexpand "false" :hexpand "false"
				(box 	:class "album_art" 
					:vexpand "false" 
					:hexpand "false" 
					:style "background-image: url('${COVER}');")

				(eventbox
					:onhover "${eww} update stack_index=1"
            				:onhoverlost "${eww} update stack_index=0"
					:orientation "v" 
					:valign "left" 
					:halign "start" 
					:vexpand "false" 
					:hexpand "false"
					(stack :selected stack_index :transition "crossfade" :same-size "false" :class "song" :halign "start" :wrap "false" :limit-width 20
						(box :spacing -7 :vexpand "false" :hexpand "false" :orientation "v"
							(label :class "song" :halign "start" :wrap "false" :limit-width 20 :text SONG)
							(label :class "artist" :halign "start" :wrap "false" :limit-width 5 :text ARTIST))
						(box :vexpand "false" :hexpand "false" :orientation "v"
							(box :class "music_buttons" :vexpand "false" :hexpand "false" :oreintation "h" 
								(button :style "background-image: url('/home/brian/.config/eww/assets/back.png');" :class "trackbutton" :onclick "scripts/music_info --prev")
								(button :style "background-image: url('${STATUS}');" :class "playbutton" :onclick "scripts/music_info --toggle")
								(button :style "background-image: url('/home/brian/.config/eww/assets/forward.png');" :class "trackbutton" :onclick "scripts/music_info --next"))))))))
							
(defwindow music
           :monitor 0
           :geometry (geometry :x "50%"
                               :y "-3.2%"
                               :width "0px"
                               :height "0px"
                               :anchor "center top")
	   :layer "overlay"
           :stacking "fg"
           :reserve (struts :distance "80px" :side "top")
           :windowtype "normal"
           :wm-ignore false
	   :namespace "eww"
(music))


(defwidget wallpaper []
	(box :class "wallpaperbox" :orientation "v"
		(box :class "wallpaperbox" :halign "center" :valign "center" :spacing 25 :space-evenly "true"
			(eventbox
				:onclick "scripts/wallpaper 'powerline_green.jpg'"
				(image :class "wallpaper" :path "${wallpaper_path}powerline_green.jpg" :image-width 200))
			(eventbox
				:onclick "scripts/wallpaper 'pinksun.jpg'"
				(image :class "wallpaper" :path "${wallpaper_path}pinksun.jpg" :image-width 200))
			(eventbox
				:onclick "scripts/wallpaper 'vaporwave1.png'"
				(image :class "wallpaper" :path "${wallpaper_path}vaporwave1.png" :image-width 200)))
		(box :class "wallpaperbox" :halign "center" :valign "center" :spacing 25 :space-evenly "true"
			(eventbox
				:onclick "scripts/wallpaper 'mountains_and_trees.png'"
				(image :class "wallpaper" :path "${wallpaper_path}mountains_and_trees.png" :image-width 200))
			(eventbox
				:onclick "scripts/wallpaper 'swirls_of_paint.jpg'"
				(image :class "wallpaper" :path "${wallpaper_path}swirls_of_paint.jpg" :image-width 200))
			(eventbox
				:onclick "scripts/wallpaper 'weeb.png'"
				(image :class "wallpaper" :path "${wallpaper_path}weeb.png" :image-width 200)))
		(box :class "wallpaperbox" :halign "center" :valign "center" :spacing 25 :space-evenly "true"
			(eventbox
				:onclick "scripts/wallpaper 'chair_on_platform.jpg'"
				(image :class "wallpaper" :path "${wallpaper_path}chair_on_platform.jpg" :image-width 200))
			(eventbox
				:onclick "scripts/wallpaper 'man_in_chair.png'"
				(image :class "wallpaper" :path "${wallpaper_path}man_in_chair.png" :image-width 200))
			(eventbox
				:onclick "scripts/wallpaper 'skeleton.png'"
				(image :class "wallpaper" :path "${wallpaper_path}skeleton.png" :image-width 200)))
		(box :spacing 10 :orientation "h" 
			(button :class "my-btn" :onclick "eww update text=\"Clicked!\" color=\"#ff0000\""
      	    :style "background-color: {color};"
      	    "Click Me")
			(button :class "my-btn" :onclick "eww update text=\"Clicked!\" color=\"#ff0000\""
      	    :style "background-color: {color};"
      	    "Click Me")

				)))


(defwindow wallpaper
	:monitor 0
	:geometry (geometry :x "0%"
			    :y "0%"
			    :width "30px"
			    :height "30px"
			    :anchor "center")
	:stacking "overlay"
	:reserve (struts :distance 0)
	:windowtype "normal"
	:wm-ignore false
(wallpaper))



;; Volume ;;
(defwidget volume []
  (eventbox :onhover "${eww} update volume=true"
            :onhoverlost "${eww} update volume=false"
            :cursor "pointer"
    (box  :class "volume"
          :tooltip "Volume: ${current-volume}%"
          :orientation "horizontal"
          :space-evenly "false"
          :spacing "2"
      (button :class "volume-icon")
      (revealer :transition "slideleft"
                :duration "300ms"
        (scale :class "volbar"
               :value current-volume
               :orientation "horizontal"
               :max 101
               :min 0
               :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")))))


;; bar ;;
(defwindow bar
          :monitor '[1, 0]'
          :geometry (geometry :x "10px"
                              :y "10px"
                              :width "99%"
                              :height "20px"
                              :anchor "top center")
          :stacking "bg"
          :exclusive "true"
          :focusable "false"
          (volume))

