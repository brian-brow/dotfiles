{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    }
  ]
}
